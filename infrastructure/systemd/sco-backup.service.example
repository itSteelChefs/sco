[Unit]
Description=SCO encrypted PostgreSQL and object-storage backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sco-backup
Group=sco-backup
UMask=0077
EnvironmentFile=/etc/sco/backup.env
RuntimeDirectory=sco-backup
RuntimeDirectoryMode=0700
ExecStart=/opt/sco/scripts/recovery/create-backup.sh --output-directory /mnt/sco-backups --destination-kind off-host --age-recipient ${SCO_BACKUP_AGE_RECIPIENT} --signing-key /etc/sco/backup-signing-key.pem
ExecStartPost=/usr/bin/node /opt/sco/apps/api/scripts/recovery/retention.mjs --directory /mnt/sco-backups --signing-public-key /etc/sco/backup-signing-public-key.pem --keep-daily ${SCO_BACKUP_KEEP_DAILY} --keep-weekly ${SCO_BACKUP_KEEP_WEEKLY} --keep-monthly ${SCO_BACKUP_KEEP_MONTHLY} --minimum-age-days ${SCO_BACKUP_MINIMUM_AGE_DAYS} --execute true --confirm DELETE:/mnt/sco-backups
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/mnt/sco-backups /run/sco-backup

[Install]
WantedBy=multi-user.target