  PARTNER
  SUPPLIER
  OTHER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum QualificationStatus {
  APPLICATION
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PartnershipType {
  BUYER_PARTNERSHIP
  SUPPLIER_PARTNERSHIP
}

enum PartnershipStatus {
  UNDER_REVIEW
  APPROVED
  ACTIVE
  SUSPENDED
  REVOKED
  REJECTED
}

