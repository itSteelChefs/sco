generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique
  passwordHash String
  status       UserStatus          @default(ACTIVE)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  memberships  CompanyMembership[]
  sessions     Session[]
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique
  issuedAt       DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime  @db.Timestamptz(6)
  idleExpiresAt  DateTime  @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model TenantProbe {
  id        String   @id @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tenant_probes")
  @@index([companyId])
}

model Company {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  type        CompanyType
  status      CompanyStatus       @default(ACTIVE)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  memberships CompanyMembership[]
  partnerships CompanyPartnership[]
}

model QualificationApplication {
  id String @id @default(uuid()) @db.Uuid
  legalName String @map("legal_name")
  contactEmail String @map("contact_email")
  status QualificationStatus @default(APPLICATION)
  submittedBy String? @map("submitted_by") @db.Uuid
  reviewedBy String? @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  decisionReason String? @map("decision_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("qualification_applications")
}

model CompanyPartnership {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  type PartnershipType
  status PartnershipStatus @default(UNDER_REVIEW)
  approvedBy String? @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  activeFrom DateTime? @map("active_from") @db.Timestamptz(6)
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  @@unique([companyId, type])
  @@index([companyId, status])
  @@map("company_partnerships")
}

model CompanyMembership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  companyId String           @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([userId, companyId])
  @@index([companyId])
}

model ProductCategory {
  id String @id @default(uuid()) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  code String @unique
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("product_categories")
}

model CategoryAttributeDefinition {
  id String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  key String
  displayName String @map("display_name")
  dataType CatalogAttributeType @map("data_type")
  required Boolean @default(false)
  unitApplicability Json? @map("unit_applicability")
  validationMetadata Json? @map("validation_metadata")
  sortOrder Int @default(0) @map("sort_order")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([categoryId, key])
  @@map("category_attribute_definitions")
}

model UnitDefinition {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  dimension String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("unit_definitions")
}

model CurrencyDefinition {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  isBase Boolean @default(false) @map("is_base")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("currency_definitions")
}

model ProductIdentity {
  id String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  brand String?
  manufacturer String?
  modelReference String? @map("model_reference")
  publicSpecification Json? @map("public_specification")
  unitId String? @map("unit_id") @db.Uuid
  warrantyType String? @map("warranty_type")
  warrantyPeriodMonths Int? @map("warranty_period_months")
  warrantyProvider String? @map("warranty_provider")
  status ProductIdentityStatus @default(DRAFT)
  version Int @default(1)
  createdBy String @map("created_by") @db.Uuid
  activatedBy String? @map("activated_by") @db.Uuid
  activatedAt DateTime? @map("activated_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([categoryId, status])
  @@map("product_identities")
}

model ProductAttributeValue {
  id String @id @default(uuid()) @db.Uuid
  productIdentityId String @map("product_identity_id") @db.Uuid
  attributeDefinitionId String @map("attribute_definition_id") @db.Uuid
  value Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([productIdentityId, attributeDefinitionId])
  @@map("product_attribute_values")
}

model ProductCandidate {
  id String @id @default(uuid()) @db.Uuid
  companyId String? @map("company_id") @db.Uuid
  submittedBy String @map("submitted_by") @db.Uuid
  origin CandidateOrigin
  status CandidateStatus @default(SUBMITTED)
  submittedName String @map("submitted_name")
  submittedDescription String? @map("submitted_description")
  requestedCategoryId String? @map("requested_category_id") @db.Uuid
  brand String?
  manufacturer String?
  modelReference String? @map("model_reference")
  submittedSpecification Json? @map("submitted_specification")
  normalizedSpecification Json? @map("normalized_specification")
  unitId String? @map("unit_id") @db.Uuid
  warrantyRequirement String? @map("warranty_requirement")
  sourceMetadata Json? @map("source_metadata")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([companyId, status])
  @@map("product_candidates")
}

model ProductMatchAssessment {
  id String @id @default(uuid()) @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid
  productIdentityId String? @map("product_identity_id") @db.Uuid
  matchedAttributes Json? @map("matched_attributes")
  differingAttributes Json? @map("differing_attributes")
  missingAttributes Json? @map("missing_attributes")
  explanation String
  status MatchAssessmentStatus @default(OPEN)
  decision MatchDecision?
  reviewedBy String? @map("reviewed_by") @db.Uuid
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("product_match_assessments")
}

model VerifyRequest {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  requestedBy String @map("requested_by") @db.Uuid
  status String @default("DRAFT")
  currentSubmittedRevisionId String? @map("current_submitted_revision_id") @db.Uuid
  humanReviewConsentedAt DateTime? @map("human_review_consented_at") @db.Timestamptz(6)
  humanReviewConsentedBy String? @map("human_review_consented_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  quoteRevisions VerifyQuoteRevision[]
  @@index([companyId, createdAt])
  @@map("verify_requests")
}

model VerifyQuoteRevision {
  id String @id @default(uuid()) @db.Uuid
  verifyRequestId String @map("verify_request_id") @db.Uuid
  predecessorRevisionId String? @map("predecessor_revision_id") @db.Uuid
  revisionNumber Int @map("revision_number")
  status String @default("DRAFT")
  submittedCurrencies String[] @map("submitted_currencies")
  commercialTerms Json @default("{}") @map("commercial_terms")
  rawContentDocumentId String? @map("raw_content_document_id") @db.Uuid
  rawContentVersionId String? @map("raw_content_version_id") @db.Uuid
  inputFingerprint String @map("input_fingerprint")
  idempotencyKey String? @map("idempotency_key")
  createdBy String @map("created_by") @db.Uuid
  submittedBy String? @map("submitted_by") @db.Uuid
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  request VerifyRequest @relation(fields: [verifyRequestId], references: [id], onDelete: Restrict)
  lines VerifyQuoteLine[]
  runs VerifyRun[]
  @@unique([verifyRequestId, revisionNumber])
  @@unique([verifyRequestId, idempotencyKey])
  @@index([verifyRequestId, createdAt])
  @@map("verify_quote_revisions")
}

model VerifyQuoteLine {
  id String @id @default(uuid()) @db.Uuid
  verifyQuoteRevisionId String @map("verify_quote_revision_id") @db.Uuid
  lineNumber Int @map("line_number")
  lineReference String? @map("line_reference")
  itemDescription String? @map("item_description")
  productIdentityId String? @map("product_identity_id") @db.Uuid
  unitId String? @map("unit_id") @db.Uuid
  quantity Decimal? @db.Decimal(18, 4)
  currencyCode String? @map("currency_code")
  unitPrice Decimal? @map("unit_price") @db.Decimal(18, 4)
  isPriceBearing Boolean @default(true) @map("is_price_bearing")
  isInformational Boolean @default(false) @map("is_informational")
  isRealZeroValue Boolean @default(false) @map("is_real_zero_value")
  readinessState String @default("NEEDS_COMPLETION") @map("readiness_state")
  readinessReason String? @map("readiness_reason")
  suspectedDuplicate Boolean @default(false) @map("suspected_duplicate")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  revision VerifyQuoteRevision @relation(fields: [verifyQuoteRevisionId], references: [id], onDelete: Restrict)
  @@unique([verifyQuoteRevisionId, lineNumber])
  @@map("verify_quote_lines")
}

model VerifyRun {
  id String @id @default(uuid()) @db.Uuid
  verifyQuoteRevisionId String @map("verify_quote_revision_id") @db.Uuid
  retryOfRunId String? @map("retry_of_run_id") @db.Uuid
  methodologyVersion String @map("methodology_version")
  evidenceFingerprint String @map("evidence_fingerprint")
  status String @default("QUEUED")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  quoteRevision VerifyQuoteRevision @relation(fields: [verifyQuoteRevisionId], references: [id], onDelete: Restrict)
  retryOf VerifyRun? @relation("VerifyRunRetry", fields: [retryOfRunId], references: [id], onDelete: Restrict)
  retries VerifyRun[] @relation("VerifyRunRetry")
  evidenceBindings VerifyEvidenceBinding[]
  results VerifyResult[]
  @@index([verifyQuoteRevisionId, createdAt])
  @@map("verify_runs")
}

model VerifyEvidenceBinding {
  id String @id @default(uuid()) @db.Uuid
  verifyRunId String @map("verify_run_id") @db.Uuid
  evidenceType String @map("evidence_type")
  sourceIdentity String @map("source_identity")
  sourceVersionIdentity String @map("source_version_identity")
  documentId String? @map("document_id") @db.Uuid
  documentVersionId String? @map("document_version_id") @db.Uuid
  effectiveDate DateTime? @map("effective_date") @db.Date
  observedAt DateTime? @map("observed_at") @db.Timestamptz(6)
  freshnessMetadata Json @default("{}") @map("freshness_metadata")
  approvalState String @map("approval_state")
  comparabilityMetadata Json @default("{}") @map("comparability_metadata")
  confidentialityClass String @map("confidentiality_class")
  integrityVersionReference String @map("integrity_version_reference")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  run VerifyRun @relation(fields: [verifyRunId], references: [id], onDelete: Restrict)
  @@map("verify_evidence_bindings")
}

model VerifyResult {
  id String @id @default(uuid()) @db.Uuid
  verifyRunId String @map("verify_run_id") @db.Uuid
  supersedesResultId String? @map("supersedes_result_id") @db.Uuid
  methodologyVersion String @map("methodology_version")
  classification String
  status String @default("PREPARED")
  coverage Json @default("{}")
  perCurrencyScopes Json @default("{}") @map("per_currency_scopes")
  confidenceContext Json @default("{}") @map("confidence_context")
  varianceData Json @default("{}") @map("variance_data")
  exclusionsLimitations Json @default("{}") @map("exclusions_limitations")
  preparedBy String? @map("prepared_by") @db.Uuid
  finalisedBy String? @map("finalised_by") @db.Uuid
  finalisedAt DateTime? @map("finalised_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  run VerifyRun @relation(fields: [verifyRunId], references: [id], onDelete: Restrict)
  @@index([verifyRunId, createdAt])
  @@map("verify_results")
}

model VerifyRunLineScope {
  id String @id @default(uuid()) @db.Uuid
  verifyRunId String @map("verify_run_id") @db.Uuid
  verifyQuoteLineId String @map("verify_quote_line_id") @db.Uuid
  isApplicable Boolean @map("is_applicable")
  capturedReadinessState String @map("captured_readiness_state")
  capturedReadinessReason String? @map("captured_readiness_reason")
  capturedCurrencyCode String? @map("captured_currency_code")
  capturedQuantity Decimal? @map("captured_quantity") @db.Decimal(18, 4)
  capturedUnitPrice Decimal? @map("captured_unit_price") @db.Decimal(18, 4)
  capturedIsRealZeroValue Boolean @default(false) @map("captured_is_real_zero_value")
  capturedAttributableValue Decimal @default(0) @map("captured_attributable_value") @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([verifyRunId, verifyQuoteLineId])
  @@map("verify_run_line_scope")
}

model VerifyLineResult {
  id String @id @default(uuid()) @db.Uuid
  verifyRunId String @map("verify_run_id") @db.Uuid
  verifyQuoteLineId String @map("verify_quote_line_id") @db.Uuid
  outcome String
  exclusionReason String? @map("exclusion_reason")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([verifyRunId, verifyQuoteLineId])
  @@index([verifyRunId])
  @@map("verify_line_results")
}

model VerifyLineResultEvidence {
  id String @id @default(uuid()) @db.Uuid
  verifyLineResultId String @map("verify_line_result_id") @db.Uuid
  verifyEvidenceBindingId String @map("verify_evidence_binding_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([verifyLineResultId, verifyEvidenceBindingId])
  @@map("verify_line_result_evidence")
}

model ProductCandidateHistory {
  id String @id @default(uuid()) @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid
  fromStatus CandidateStatus? @map("from_status")
  toStatus CandidateStatus @map("to_status")
  actorUserId String @map("actor_user_id") @db.Uuid
  reason String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([candidateId, createdAt])
  @@map("product_candidate_history")
}

