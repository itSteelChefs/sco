POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD
DATABASE_URL=postgresql://sco_dev:CHANGE_ME_LOCAL_POSTGRES_PASSWORD@127.0.0.1:54329/sco_dev
RUNTIME_DATABASE_PASSWORD=CHANGE_ME_LOCAL_RUNTIME_PASSWORD
RUNTIME_DATABASE_URL=postgresql://sco_runtime:CHANGE_ME_LOCAL_RUNTIME_PASSWORD@127.0.0.1:54329/sco_dev
SCO_INTERNAL_DATABASE_URL=postgresql://sco_internal_executor:CHANGE_ME_LOCAL_INTERNAL_PASSWORD@127.0.0.1:54329/sco_dev
SCO_INTERNAL_DATABASE_PASSWORD=CHANGE_ME_LOCAL_INTERNAL_PASSWORD
SESSION_SECRET=CHANGE_ME_LOCAL_SESSION_SECRET
NODE_ENV=development
SCO_DOCUMENT_STORAGE=local
# Required when NODE_ENV is staging or production:
# SCO_DOCUMENT_STORAGE=s3
# SCO_S3_BUCKET=CHANGE_ME_PRIVATE_BUCKET
# SCO_S3_REGION=CHANGE_ME_REGION
# SCO_S3_ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY
# SCO_S3_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY
# Optional for S3-compatible providers:
# SCO_S3_ENDPOINT=https://object-storage.example
# SCO_S3_FORCE_PATH_STYLE=true
API_ORIGIN=http://127.0.0.1:3101
PARTNER_WEB_ORIGIN=http://127.0.0.1:3102
OPERATIONS_WEB_ORIGIN=http://127.0.0.1:3103
# Optional observability. Leave DSNs unset to disable external telemetry.
# LOG_LEVEL=info
# SCO_METRICS_TOKEN=CHANGE_ME_AT_LEAST_32_CHARACTERS
# SENTRY_DSN=https://PUBLIC_KEY@example.invalid/PROJECT_ID
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=FULL_GIT_COMMIT_SHA
# Browser Sentry values are public build-time configuration, not secrets.
# NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@example.invalid/PROJECT_ID
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_RELEASE=FULL_GIT_COMMIT_SHA
